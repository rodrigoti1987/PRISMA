# ============================================================
# Oracle — modo Thin (sem Instant Client, sem tnsnames.ora)
# DSN no formato HOST:PORTA/SERVICO
# ============================================================
ORACLE_USER=app_painel
ORACLE_PASSWORD=
ORACLE_DSN=10.0.0.15:1521/ORCL
ORACLE_POOL_MIN=2
ORACLE_POOL_MAX=10
ORACLE_CALL_TIMEOUT_MS=15000

# ============================================================
# Segurança da API
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================
API_TOKEN=

# ============================================================
# Comportamento
# ============================================================
CACHE_TTL_SECONDS=30
LOG_LEVEL=INFO
